# ===========================================
# APS Performance Assistant - Cloud Run Environment Variables
# ===========================================
#
# Copy this file to .env.cloudrun and fill in your values
# These are used during local development and can inform Cloud Run setup
#

# ===========================================
# Required: OpenAI Configuration
# ===========================================
OPENAI_API_KEY=sk-your-openai-api-key-here

# ===========================================
# Optional: Model Configuration
# ===========================================
LLM_MODEL=gpt-4o
LLM_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-large

# ===========================================
# Google Cloud Configuration
# ===========================================
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=australia-southeast1

# ===========================================
# Database (Neon Postgres) - Optional
# If not provided, Cognee will use local storage
# ===========================================
# DB_PROVIDER=postgres
# DB_HOST=your-neon-host.neon.tech
# DB_PORT=5432
# DB_NAME=neondb
# DB_USER=your-db-user
# DB_PASSWORD=your-db-password
# DB_SSL_MODE=require

# ===========================================
# Frontend Environment (set during build)
# ===========================================
# NEXT_PUBLIC_BACKEND_URL will be auto-set by cloudbuild.yaml
